{
  "name": "agent-os",
  "version": "0.3.0",
  "description": "Agent OS — 你的个人生产系统",
  "type": "module",
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env src/index.ts",
    "start:once": "tsx src/index.ts",
    "build": "tsc",
    "probe:cli": "tsx src/probe-cli.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.3.0",
    "commit-and-tag-version": "^13.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm run lint",
    "*": "pnpm run fmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5"
}
